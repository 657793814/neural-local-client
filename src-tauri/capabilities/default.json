{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "本地题库默认权限：本机命令、文件选择、全局热键与核心能力。只给本地页面，内嵌的第三方网页不在其中。",
  "webviews": ["main", "overlay"],
  "permissions": [
    "local-commands",
    "core:default",
    "dialog:default",
    "global-shortcut:default"
  ]
}
